<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A stand-in for the internal DoverPort.Emails package: PodEmailBuilder, which assembles the
    house-styled HTML body. String building only - no transport, no templating engine, no
    dependencies.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DoverPort.Emails</RootNamespace>
  </PropertyGroup>

</Project>
