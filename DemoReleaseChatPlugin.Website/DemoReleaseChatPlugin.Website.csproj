<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    ImplicitUsings is DISABLED here on purpose. Every file in this project spells out its usings,
    `using System;` included. Match the convention - do not "fix" it.
    MSG0005 is a Mediator source-generator warning that is expected in this layout.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DemoReleaseChatPlugin.Website</RootNamespace>
    <NoWarn>$(NoWarn);MSG0005</NoWarn>
    <UserSecretsId>demoreleasechatplugin-website</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageReference Include="Blazored.FluentValidation" Version="2.2.0" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Mediator.SourceGenerator" Version="3.0.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.8.0" />
    <PackageReference Include="Microsoft.Graph" Version="5.100.0" />
    <!--
      Microsoft.Graph.Core 3.2.6 is a transitive security pin for GHSA-7j59-v9qr-6fq9: Kiota's
      RedirectHandler leaked Cookie and Proxy-Authorization headers across hosts on 3xx redirects.
      Every Microsoft.Graph 5.x pins Graph.Core 3.2.5 -> Kiota 1.21.1, so bumping Graph cannot fix
      it. 3.2.6 is the first release on Kiota 1.22.1 and satisfies Graph 5.100.0's ">= 3.2.5".
    -->
    <PackageReference Include="Microsoft.Graph.Core" Version="3.2.6" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.3.0" />
    <PackageReference Include="Microsoft.Identity.Web.GraphServiceClient" Version="4.3.0" />
    <PackageReference Include="Microsoft.Identity.Web.UI" Version="4.3.0" />
    <PackageReference Include="Radzen.Blazor" Version="8.6.4" />
    <PackageReference Include="Scrutor" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DemoReleaseChatPlugin.Contracts\DemoReleaseChatPlugin.Contracts.csproj" />
    <ProjectReference Include="..\DemoReleaseChatPlugin.Application\DemoReleaseChatPlugin.Application.csproj" />
    <ProjectReference Include="..\DemoReleaseChatPlugin.Infrastructure\DemoReleaseChatPlugin.Infrastructure.csproj" />
    <ProjectReference Include="..\DemoReleaseChatPlugin.RazorComponents\DemoReleaseChatPlugin.RazorComponents.csproj" />
    <ProjectReference Include="..\Shared\DoverPort.AspNetCore.Common\DoverPort.AspNetCore.Common.csproj" />
    <ProjectReference Include="..\Shared\DoverPort.Common.Models\DoverPort.Common.Models.csproj" />
    <ProjectReference Include="..\DemoReleaseChatPlugin.Assistant\DemoReleaseChatPlugin.Assistant.csproj" />
  </ItemGroup>


  <!--
    The domain model, slices and pages are written in the nullable-oblivious style the spec
    prescribes verbatim (`Name = name?.Trim();` onto a non-nullable `string Name`), while the spec
    also pins Nullable=enable for this project. Keeping both means several hundred CS86xx warnings
    that would bury any real one, so the nullable-flow diagnostics are silenced here and nowhere
    else. The annotation context stays on, so `string?` still means something on the API surface.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CS8618;CS8601;CS8602;CS8603;CS8604;CS8619;CS8620;CS8625</NoWarn>
  </PropertyGroup>

</Project>
