@using DemoReleaseChatPlugin.Application.Authorization.GetUsersWithRoles
@inherits AllUsersBase

<RadzenDataGrid Data="@Users" TItem="GetUsersWithRolesResult.UserDto" IsLoading="@IsBusy"
                ColumnWidth="100%" AllowFiltering="true" AllowColumnResize="true" AllowSorting="true"
                FilterMode="FilterMode.SimpleWithMenu"
                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                LogicalFilterOperator="LogicalFilterOperator.And"
                GridLines="DataGridGridLines.Horizontal" Style="max-height: 65vh"
                EmptyText="No users yet. Use the Search People tab to add the first one.">
    <Columns>

        <RadzenDataGridColumn TItem="GetUsersWithRolesResult.UserDto" Property="Name" Title="Name">
            <Template Context="data">
                @* A clickable pseudo-link: both tabs navigate to the same user detail page. *@
                <span style="cursor:pointer; color:var(--rz-primary); text-decoration:underline"
                      @onclick="() => ManageUser(data.Id)">@data.Name</span>
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="GetUsersWithRolesResult.UserDto" Title="Roles"
                              Sortable="false" Filterable="false">
            <Template Context="data">
                @string.Join(", ", data.Roles)
            </Template>
        </RadzenDataGridColumn>

    </Columns>
</RadzenDataGrid>
