@page "/releases/scheduled/new"
@using DemoReleaseChatPlugin.Application.Authorization
@using DemoReleaseChatPlugin.Domain.Releases.Values
@using DemoReleaseChatPlugin.Application.Releases.Notices.Lookups
@attribute [Authorize(Roles = RoleConstants.ItAdmin)]
@inherits ScheduleReleaseBase

<h4 class="mb-3">Schedule a release</h4>

<Loader IsReady="IsReady">
    <RadzenCard>
        @if (Projects.Count == 0)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">
                There are no active projects yet. Create one under Releases &gt; Projects first.
            </RadzenAlert>
        }
        else
        {
            @* OnSubmit, not OnValidSubmit - the handler calls IsValidAsync itself, so an invalid form
               re-renders messages without a round trip. The onkeypress attribute stops Enter
               submitting from any field except a textarea. *@
            <EditForm Model="@Command" OnSubmit="@SubmitAsync"
                      onkeypress="return event.keyCode != 13 || event.target.tagName == 'TEXTAREA'">
                <FluentValidationValidator @ref="Validator" />

                <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">

                    <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap">

                        <div>
                            <RadzenLabel Text="Project" />
                            <div>
                                <RadzenDropDown TValue="ProjectId" @bind-Value="Command.ProjectId" Data="@Projects"
                                                TextProperty="Name" ValueProperty="Id" AllowFiltering="true"
                                                Style="width:300px" Placeholder="Choose a project..." />
                            </div>
                            <ValidationMessage For="@(() => Command.ProjectId)" />
                        </div>

                        <div>
                            <RadzenLabel Text="Version number" />
                            <div><RadzenTextBox @bind-Value="Command.Version" Style="width:180px" Placeholder="e.g. 2.1.0" /></div>
                            <ValidationMessage For="@(() => Command.Version)" />
                        </div>

                        <div>
                            <RadzenLabel Text="Planned date and time" />
                            <div>
                                <RadzenDatePicker TValue="DateTime" @bind-Value="Command.ScheduledFor" ShowTime="true"
                                                  DateFormat="dd/MM/yyyy HH:mm" Style="width:240px" />
                            </div>
                            <ValidationMessage For="@(() => Command.ScheduledFor)" />
                        </div>

                        <div>
                            <RadzenLabel Text="Risk / impact (optional)" />
                            <div>
                                <RadzenDropDown TValue="RiskLevel" @bind-Value="Command.RiskLevel" Data="@RiskLevels"
                                                AllowClear="true" Style="width:180px" Placeholder="Not flagged"
                                                Change="@(_ => OnRiskLevelChanged())" />
                            </div>
                            <ValidationMessage For="@(() => Command.RiskLevel)" />
                        </div>

                        <div>
                            <RadzenLabel Text="Lead developer" />
                            <div><RadzenTextBox @bind-Value="Command.LeadDeveloper" Style="width:260px" /></div>
                            <ValidationMessage For="@(() => Command.LeadDeveloper)" />
                        </div>

                    </RadzenStack>

                    @if (Command.RiskLevel is not null)
                    {
                        <div>
                            <RadzenLabel Text="@($"What is the {Command.RiskLevel.ToString().ToLowerInvariant()} risk, and who does it affect?")" />
                            <div>
                                <RadzenTextArea @bind-Value="Command.RiskNotes" Rows="3"
                                                Style="max-width:820px; width:100%"
                                                Placeholder="e.g. the payments API is unavailable for around ten minutes; the finance team should avoid raising invoices during the window." />
                            </div>
                            <ValidationMessage For="@(() => Command.RiskNotes)" />
                        </div>
                    }

                    <div>
                        <RadzenLabel Text="Summary of changes" />
                        <div>
                            <RadzenTextArea @bind-Value="Command.Summary" Rows="4" Style="max-width:820px; width:100%" />
                        </div>
                        <ValidationMessage For="@(() => Command.Summary)" />
                    </div>

                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                        <RadzenButton ButtonType="ButtonType.Submit" Text="Schedule and notify"
                                      ButtonStyle="ButtonStyle.Primary" Disabled="@IsSubmitting" />
                        <RadzenButton ButtonStyle="ButtonStyle.Light" Text="Cancel" Click="Cancel"
                                      ButtonType="ButtonType.Button" />
                    </RadzenStack>

                </RadzenStack>
            </EditForm>
        }
    </RadzenCard>
</Loader>
