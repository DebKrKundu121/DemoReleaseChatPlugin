@page "/releases/rollbacks/new"
@page "/releases/rollbacks/new/{LiveReleaseId:guid}"
@using DemoReleaseChatPlugin.Application.Authorization
@using DemoReleaseChatPlugin.Application.Releases.Notices.Lookups
@attribute [Authorize(Roles = RoleConstants.ItAdmin)]
@inherits LogRollbackBase

<h4 class="mb-3">Log a rollback</h4>

<Loader IsReady="IsReady">
    <RadzenCard>
        @if (Candidates.Count == 0)
        {
            <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">
                There are no live releases available to roll back. A release must be recorded as live
                first, and each release can only be rolled back once.
            </RadzenAlert>
        }
        else
        {
            <EditForm Model="@Command" OnSubmit="@SubmitAsync"
                      onkeypress="return event.keyCode != 13 || event.target.tagName == 'TEXTAREA'">
                <FluentValidationValidator @ref="Validator" />

                <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">

                    <div>
                        <RadzenLabel Text="Release being rolled back" />
                        <div>
                            <RadzenDropDown TValue="ReleaseNoticeId" @bind-Value="Command.LiveReleaseId" Data="@Candidates"
                                            TextProperty="Display" ValueProperty="Id" AllowFiltering="true"
                                            Style="max-width:520px; width:100%" />
                        </div>
                        <ValidationMessage For="@(() => Command.LiveReleaseId)" />

                        @if (SelectedCandidate is not null)
                        {
                            <RadzenText TextStyle="TextStyle.Caption">
                                This rollback will be recorded against version
                                <strong>@SelectedCandidate.Version</strong> of @SelectedCandidate.ProjectName.
                            </RadzenText>
                        }
                    </div>

                    <div>
                        <RadzenLabel Text="Rollback time" />
                        <div>
                            <RadzenDatePicker TValue="DateTime?" @bind-Value="Command.RolledBackOn" ShowTime="true"
                                              DateFormat="dd/MM/yyyy HH:mm" Style="width:240px" />
                        </div>
                        <ValidationMessage For="@(() => Command.RolledBackOn)" />
                    </div>

                    <div>
                        <RadzenLabel Text="Reason for rollback" />
                        <div>
                            <RadzenTextArea @bind-Value="Command.RollbackReason" Rows="4"
                                            Style="max-width:820px; width:100%" />
                        </div>
                        <ValidationMessage For="@(() => Command.RollbackReason)" />
                    </div>

                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                        @* Danger, because this is a destructive record. *@
                        <RadzenButton ButtonType="ButtonType.Submit" Text="Log rollback and notify"
                                      ButtonStyle="ButtonStyle.Danger" Disabled="@IsSubmitting" />
                        <RadzenButton ButtonStyle="ButtonStyle.Light" Text="Cancel" Click="Cancel"
                                      ButtonType="ButtonType.Button" />
                    </RadzenStack>

                </RadzenStack>
            </EditForm>
        }
    </RadzenCard>
</Loader>
