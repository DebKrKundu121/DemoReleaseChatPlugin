<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DemoReleaseChatPlugin.Application</RootNamespace>
  </PropertyGroup>

  <!--
    DoverPort.Common.Models and DoverPort.Common.Pipeline come from the Shared project instead of
    NuGet. OpenTelemetry.Api 1.15.3 is deliberately absent: it was only a transitive security pin
    for GHSA-g94r-2vxg-569j arriving via the real Pipeline package, and our Pipeline shim has no
    OpenTelemetry half at all.
  -->
  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.2" />
    <PackageReference Include="Scrutor" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DemoReleaseChatPlugin.Contracts\DemoReleaseChatPlugin.Contracts.csproj" />
    <ProjectReference Include="..\Shared\DoverPort.Common.Models\DoverPort.Common.Models.csproj" />
    <ProjectReference Include="..\Shared\DoverPort.Common.Pipeline\DoverPort.Common.Pipeline.csproj" />
    <ProjectReference Include="..\DemoReleaseChatPlugin.Domain\DemoReleaseChatPlugin.Domain.csproj" />
  </ItemGroup>


  <!--
    The domain model, slices and pages are written in the nullable-oblivious style the spec
    prescribes verbatim (`Name = name?.Trim();` onto a non-nullable `string Name`), while the spec
    also pins Nullable=enable for this project. Keeping both means several hundred CS86xx warnings
    that would bury any real one, so the nullable-flow diagnostics are silenced here and nowhere
    else. The annotation context stays on, so `string?` still means something on the API surface.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CS8618;CS8601;CS8602;CS8603;CS8604;CS8619;CS8620;CS8625</NoWarn>
  </PropertyGroup>

</Project>
