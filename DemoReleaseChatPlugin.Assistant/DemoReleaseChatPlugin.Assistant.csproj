<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DemoReleaseChatPlugin.Assistant</RootNamespace>
  </PropertyGroup>

  <!--
    The AI assistant module. It reaches system data only through Application's Mediator queries and
    interfaces, never the database directly, so Application is its only project reference.
    Infrastructure and Website reference this project; nothing else depends on it.
  -->
  <ItemGroup>
    <ProjectReference Include="..\DemoReleaseChatPlugin.Application\DemoReleaseChatPlugin.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.0" />
  </ItemGroup>

  <!--
    Same nullable posture as Application: annotations on, nullable-flow diagnostics silenced, because
    the module follows the spec's nullable-oblivious style.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CS8618;CS8601;CS8602;CS8603;CS8604;CS8619;CS8620;CS8625</NoWarn>
  </PropertyGroup>

</Project>
